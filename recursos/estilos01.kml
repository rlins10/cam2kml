<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Biblioteca de Estilos</name>

    <!-- Estilo para o Ponto -->
    <Style id="estiloPonto">
      <IconStyle>
        <scale>1.1</scale>
        <Icon>
          <href>../icons/pole.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <!-- Estilo para o Polígono -->
    <Style id="estiloPoligono">
      <LineStyle>
        <color>ff0000ff</color>
        <width>2</width>
      </LineStyle>
      <PolyStyle>
        <color>7f00ff00</color> <!-- Preenchimento translúcido (AABBGGRR) -->
      </PolyStyle>
    </Style>
    
    <!-- Definição do Estilo com o Template do Balão -->
    <Style id="estiloCustomizado">
      <IconStyle>
        <scale>0.8</scale>
        <Icon>
          <href>../icons/icons8-galeria-48.png</href>
        </Icon>
      </IconStyle>
      <BalloonStyle>
        <!-- O texto define o template global para os placemarks que usarem este estilo -->
        <text><![CDATA[
          <!-- Bloco de Estilos CSS embutido -->
          <style>
            .kml-card {
              font-family: Arial, sans-serif;
              width: 380px;
              border-radius: 8px;
              overflow: hidden;
              box-shadow: 0 4px 8px rgba(0,0,0,0.15);
              border: 1px solid #ddd;
            }
            .kml-header {
              background-color: #2c3e50;
              color: #ffffff;
              padding: 12px;
              font-size: 16px;
              font-weight: bold;
              text-align: center;
            }
            .kml-body {
              padding: 15px;
              background-color: #f8f9fa;
              color: #333333;
              font-size: 13px;
              line-height: 1.4;
            }
            .kml-footer {
              background-color: #ecf0f1;
              padding: 8px 15px;
              font-size: 11px;
              color: #7f8c8d;
              border-top: 1px solid #ddd;
              text-align: right;
            }
            .badge {
              display: inline-block;
              padding: 3px 6px;
              font-size: 10px;
              font-weight: bold;
              color: #fff;
              background-color: #27ae60;
              border-radius: 4px;
            }
          </style>

          <!-- Estrutura HTML do Balão usando as variáveis do KML -->
          <div class="kml-card">
            <div class="kml-header">
              $[name]
            </div>
            <div class="kml-body">
              <p>$[description]</p>
              <!-- Exemplo de dado extra personalizado (ExtendedData) -->
              <p><b>Camera:</b> <span class="badge">$[camera]</span></p>
              <p><b>Data:</b> <span class="badge">$[data]</span></p>
            </div>
            <div class="kml-footer">
              Tamanho: $[isize]
            </div>
          </div>
        ]]></text>
      </BalloonStyle>
    </Style>
  </Document>
</kml>
