<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Biblioteca de Estilos</name>

    <!-- Estilo para o Ponto -->
    <Style id="estiloPonto">
      <IconStyle>
        <scale>1.1</scale>
        <Icon>
          <href>../icons/pole.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <!-- Estilo para o Polígono -->
    <Style id="estiloPoligono">
      <LineStyle>
        <color>ff0000ff</color>
        <width>2</width>
      </LineStyle>
      <PolyStyle>
        <color>7f00ff00</color>
      </PolyStyle>
    </Style>
    
    <!-- Definição do Estilo Customizado para Fotos (Modularizado) -->
    <Style id="estiloCustomizado">
      <IconStyle>
        <scale>0.8</scale>
        <Icon>
          <href>../icons/icons8-galeria-48.png</href>
        </Icon>
      </IconStyle>
      <BalloonStyle>
        <text><![CDATA[
          <div style="width: 680px; max-height: 600px; overflow-y: auto; font-family: Arial, sans-serif; background-color: #ffffff; border: 1px solid #cccccc; border-radius: 6px;">
            
            <!-- Cabeçalho -->
            <div style="background-color: #2c3e50; color: #ffffff; padding: 10px 12px; font-size: 14px; font-weight: bold;">
              📁 $[name]
            </div>

            <!-- Corpo Principal -->
            <div style="padding: 12px; color: #333333; font-size: 12px;">
              
              <!-- Miniatura da Imagem Controlada (Máx 640x480) clicável para a original -->
              <div style="margin-bottom: 12px; text-align: center; background: #f8f9fa; padding: 8px; border-radius: 4px; border: 1px solid #e9ecef;">
                <a href="$[foto_url]" title="Abrir imagem original">
                  <img src="$[foto_url]" style="max-width: 640px; max-height: 480px; width: auto; height: auto; display: block; margin: 0 auto; border-radius: 2px;" />
                </a>
              </div>

              <!-- Tabela de Metadados com o link discreto "Foto Original" alinhado -->
              <table width="100%" style="font-size: 11px; color: #555555; border-top: 1px solid #e0e0e0; padding-top: 8px; margin-top: 4px;">
                <tr>
                  <td><b>Câmera:</b> $[camera]</td>
                  <td><b>Data:</b> $[data]</td>
                </tr>
                <tr>
                  <td style="padding-top: 4px;"><b>Tamanho:</b> $[isize]</td>
                  <td align="right" style="padding-top: 4px;">
                    <a href="$[foto_url]" style="color: #6c757d; text-decoration: none; font-size: 11px; font-weight: normal;">[ Foto Original ]</a>
                  </td>
                </tr>
              </table>

            </div>

            <!-- Rodapé -->
            <div style="background-color: #ecf0f1; padding: 6px 12px; font-size: 10px; color: #7f8c8d; border-top: 1px solid #dddddd; text-align: right;">
              PhotoSync - Visualização Georreferenciada
            </div>

          </div>
        ]]></text>
      </BalloonStyle>
    </Style>
  </Document>
</kml>
